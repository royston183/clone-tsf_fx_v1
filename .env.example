# Copy to .env.local and fill in. Never commit .env.local.
# A value already in the process environment, even an empty one, wins over this file.

# --- BackEnd (FE + BE + DB only): the application's own data, never SAP -------------------------------------------
# Demo only: the BackEnd has no authentication. Any client that reaches it can read and write the application's own
# data and claim any x-app-user; CORS and the x-app-request header only stop browsers. Harden it by hand per
# application before production use.

# Ports (npm run dev): the FrontEnd and the BackEnd run on two ports; the FrontEnd calls the BackEnd's port.
FRONTEND_PORT=3100
BACKEND_PORT=3200

# The FrontEnd origins allowed to call the BackEnd (CORS) and send writes (comma separated).
# Empty: http://127.0.0.1:<FRONTEND_PORT>,http://localhost:<FRONTEND_PORT>
APP_ORIGINS=

# The SQLite database (default DB/app.db, built from DB/schema; ':memory:' keeps nothing). On a Function App:
# a writable file such as /home/data/app.db (docs/deploy-function-app.md)
DB_PATH=

# --- FrontEnd build (both application types) ----------------------------------------------------------------------
# Only VITE_* values reach the browser, and they are built into the page: anyone who opens it can read them.

# The BackEnd (FE + BE + DB). Empty: this page's host on the BackEnd port.
VITE_API_BASE_URL=

# The local SAP relay, built separately; it runs on the user's PC, on the VPN. Empty: http://localhost:3001
VITE_SAP_RELAY_URL=
# The SAP system shown on the screens, the SAP client (sent as sap-client on every call) and the call timeout.
VITE_SAP_SYSTEM_ID=DS4_100_TFSIN
VITE_SAP_CLIENT=100
VITE_SAP_TIMEOUT_MS=30000

# The default SAP account, for local builds only: it is built into the page. Empty: each person enters theirs in
# Settings > SAP Connection (Test & save, for the tab). The deploy pipeline never passes these two.
VITE_SAP_USERNAME=
VITE_SAP_PASSWORD=

# --- Deployment (npm run deploy) ------------------------------------------------------------------------------------
# Keep PROVISIONER_KEY only in .env.local or the process environment.
PROVISIONER_BASE_URL=https://provisioner-fa-f6bbbncphvbgbkfe.centralindia-01.azurewebsites.net
PROVISIONER_KEY=

PROVISIONER_OWNER=
